{
  "expo": {
    "name": "portion",
    "slug": "portion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "portion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.portion",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.portion",
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A34A",
          "image": "./assets/images/leaf-white.png",
          "imageWidth": 240
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "david-93t",
          "project": "react-native"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Portion to use your camera to log meals and scan barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Portion to access your photos so you can log meals from pictures you've already taken."
        }
      ],
      "expo-localization",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Portion to count your daily steps."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "31645473155-lgpm5ribd8kphajp5b6bbnhtu28rqqrp.apps.googleusercontent.com",
      "eas": {
        "projectId": "6d3d219b-4557-4206-8d7f-76bbcccd187e"
      }
    },
    "owner": "david_opab"
  }
}
